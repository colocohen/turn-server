{
  "name": "turn-server",
  "version": "0.6.0",
  "description": "STUN/TURN server + client + full ICE agent for Node.js - UDP, TCP, TLS, WebSocket and DTLS transports",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "stun",
    "turn",
    "webrtc",
    "wrtc",
    "ice",
    "ice-agent",
    "nat",
    "websocket",
    "rfc5389",
    "rfc5766",
    "rfc8445",
    "rfc7675",
    "rfc7350"
  ],
  "author": {
    "name": "colocohen"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/colocohen/turn-server.git"
  },
  "bugs": {
    "url": "https://github.com/colocohen/turn-server/issues"
  },
  "homepage": "https://github.com/colocohen/turn-server#readme",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/colocohen"
    }
  ],
  "optionalDependencies": {
    "lemon-tls": "^0.7.0",
    "mdns-local": "^0.1.0",
    "port-mapper": "^0.1.3",
    "ws": "^8.18.0"
  }
}